    <string name="accessibility_disclosure_title">Why Lockout Gate needs Accessibility</string>
    <string name="accessibility_disclosure_message">Lockout Gate uses the Accessibility service to detect which app is open, so it can block the apps you chose when no break is active.\n\nOnly during a hard lock that you start yourself, it also reads text on the Settings and app-installer screens to stop the service being turned off or the app being uninstalled until the lock ends.\n\nScreen content is checked on your phone only. It is never stored or sent anywhere.</string>
    <string name="accessibility_disclosure_agree">Agree and continue</string>
    <string name="accessibility_disclosure_decline">Not now</string>

