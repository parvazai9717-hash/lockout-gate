<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="12dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_keep_me_out"
            android:textColor="@color/text_primary_light"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/focus_subtitle"
            android:textColor="@color/text_secondary_light"
            android:textAppearance="?attr/textAppearanceBody2" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/background_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke_light"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/focusStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="@color/text_primary_light"
                android:textAppearance="?attr/textAppearanceSubtitle1" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/publicFocusAccountPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/publicFocusAccountMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/public_focus_setup_message"
                android:textColor="@color/text_primary_light" />

            <Button
                android:id="@+id/publicFocusEnrollButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/public_focus_setup_title" />

            <Button
                android:id="@+id/publicFocusRecoverButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/public_focus_recover" />

            <Button
                android:id="@+id/publicFocusDeleteButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/public_focus_delete" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/focusSetupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_card_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorError"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/focus_setup_needed"
                    android:textColor="@color/text_primary_light"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <Button
                    android:id="@+id/focusEnableServiceButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/enable_accessibility" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/focus_presets_label"
            android:textColor="@color/text_primary_light"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/focusPresetGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="false"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/focus_custom_label"
            android:textColor="@color/text_primary_light"
            android:textAppearance="?attr/textAppearanceSubtitle2" />

        <EditText
            android:id="@+id/focusCustomAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/focus_custom_hint"
            android:textColor="@color/text_primary_light"
            android:textColorHint="@color/text_secondary_light"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/focusUnitGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/focusUnitMinutes"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_minutes" />

            <com.google.android.material.chip.Chip
                android:id="@+id/focusUnitHours"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/unit_hours" />

            <com.google.android.material.chip.Chip
                android:id="@+id/focusUnitDays"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_days" />
        </com.google.android.material.chip.ChipGroup>

        <Button
            android:id="@+id/focusStartButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:text="@string/focus_start"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/focus_footnote"
            android:textColor="@color/text_secondary_light"
            android:textAppearance="?attr/textAppearanceCaption" />

    </LinearLayout>
</ScrollView>
