<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Custom Background Image -->
    <ImageView
        android:id="@+id/customBackgroundImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Dark Scrim Overlay -->
    <View
        android:id="@+id/backgroundScrimView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#70000000"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@string/title_manage_apps"
                android:src="@drawable/ic_shield_lock"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/title_manage_apps"
                android:textColor="@color/text_primary_light"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mode Toggle Tabs -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:checkedButton="@id/btnStandardMode"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStandardMode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_standard"
                app:backgroundTint="@color/tab_button_bg"
                android:textColor="@color/tab_button_content"
                app:iconTint="@color/tab_button_content"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStrictArea"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_strict_permanent"
                app:backgroundTint="@color/tab_button_bg"
                android:textColor="@color/tab_button_content"
                app:iconTint="@color/tab_button_content"
                android:textSize="13sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Description Note -->
        <TextView
            android:id="@+id/modeDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="@color/text_secondary_light"
            android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/appsProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="32dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

    </LinearLayout>
</FrameLayout>
